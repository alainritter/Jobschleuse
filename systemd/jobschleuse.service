[Unit]
Description=Jobschleuse web UI (:8765)
After=network.target

# User unit. Assumes the checkout is at ~/Dev/Jobschleuse and uv is in ~/.local/bin;
# adjust both lines if not. Further settings (JOBS_ALLOWED_HOSTS, JOBS_WEB_TOKEN, LLM_*) go into .env.
[Service]
Type=simple
WorkingDirectory=%h/Dev/Jobschleuse
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=%h/.local/bin/uv run jobs serve --no-browser
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
